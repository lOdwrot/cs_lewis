{
  "kind": "singleType",
  "collectionName": "news_pages",
  "info": {
    "singularName": "news-page",
    "pluralName": "news-pages",
    "displayName": "News Page",
    "description": "Editable content for the public Aktualności page"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "backgroundImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "news": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::news.news"
    }
  }
}
